# Expo client. Copy to .env.local (gitignored) for local development; for EAS
# builds set the same names as EAS environment variables instead.
#
# EXPO_PUBLIC_ values are embedded in the app bundle — anon-scoped only, never
# a service-role key or an OAuth secret.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
