# Web application (Vite). Copy to .env.local and fill in.
# Only VITE_-prefixed values reach the browser bundle; never put a service-role
# key or an OAuth secret in this file.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Enables the seeded email/password sign-in path. Ignored by production builds
# (see packages/domain/src/auth.ts — production is Google/Apple only).
VITE_ENABLE_TEST_AUTH=false

# ---------------------------------------------------------------------------
# Not part of the web build. Documented here so every name lives in one place.
# ---------------------------------------------------------------------------
#
# Seed script (scripts/seed-household.ts), exported on the command line only:
#   SUPABASE_URL=
#   SUPABASE_SERVICE_ROLE_KEY=
#
# Local Supabase OAuth providers (supabase/config.toml reads these; leave unset
# to keep the providers disabled locally):
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
#   SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
#   SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
#   SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
#
# Edge Function secrets (set with `supabase secrets set`, never committed).
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are injected
# by the platform; only the Expo token has to be supplied:
#   EXPO_ACCESS_TOKEN=   # optional, required only if Expo push security is on
